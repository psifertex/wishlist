// Local development and test configuration. It contains no deployment-specific
// values. To deploy, copy wrangler.deploy.example.jsonc to wrangler.deploy.jsonc
// (untracked) and fill in your own IDs and hostnames.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wishlist",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "public", "run_worker_first": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "wishlist", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "wishlist-images" }],
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CLAIM", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["17 8 * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    // Browsers resolve *.localhost to 127.0.0.1, so person hostnames such as
    // pat.localhost:8787 work locally without editing /etc/hosts.
    "MAIN_HOST": "localhost",
    "TIMEZONE": "America/New_York",
    "DEV_AUTH_EMAIL": "admin@example.com",
    "BOOTSTRAP_ADMIN_EMAIL": "admin@example.com"
  }
}
